{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoMusic",
  "version": "26.11.5",
  "identifier": "net.myocd.gomusic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GoMusic",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' asset: data: blob: https:; font-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: tauri: https://mapi.myocd.de5.net https://translate.mapi.myocd.de5.net https://api.github.com https://gh-proxy.com https://v6.gh-proxy.com https://github.com https://p1.music.126.net https://p2.music.126.net https://p3.music.126.net https://p4.music.126.net https://m801.music.126.net; frame-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline'",
      "capabilities": [
        "main-capability"
      ]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "mimeType": "audio/mpeg",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "flac"
        ],
        "mimeType": "audio/flac",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "m4a",
          "aac"
        ],
        "mimeType": "audio/mp4",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "ape"
        ],
        "mimeType": "audio/x-ape",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "wav"
        ],
        "mimeType": "audio/wav",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "mimeType": "audio/ogg",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "wma"
        ],
        "mimeType": "audio/x-ms-wma",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "aiff",
          "aif"
        ],
        "mimeType": "audio/aiff",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "dsf",
          "dff"
        ],
        "mimeType": "audio/vnd.dsd",
        "rank": "Alternate",
        "description": "GoMusic Audio"
      },
      {
        "ext": [
          "lrc"
        ],
        "mimeType": "text/plain",
        "rank": "Alternate",
        "description": "GoMusic Lyrics"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTGMoFrnVspeyjNNBfeDqot8gNhq70MzwqxKpYurxMZpT6D3M2iQiNK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/ike-lee-820/gomusic-desktop/releases/latest/download/latest.json",
        "https://github.com/ike-lee-820/gomusic-desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "gomusic"
        ]
      }
    }
  }
}
